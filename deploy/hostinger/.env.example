# TVVIDAA: environment settings in Dokploy (never commit live secrets)
PUBLIC_BASE_URL=https://tv.rfcsas.com
MEDIA_TOKEN_SECRET=<generate-a-random-value-at-least-32-characters>
VIDAA_WEB_PASSWORD=<private-password-at-least-14-characters>
VIDAA_SESSION_SECRET=<independent-random-value-at-least-32-characters>
# Passwordless is optional and makes public API/media reachable to visitors.
VIDAA_PASSWORDLESS=false
VIDAA_PUBLIC_ACCESS_ACK=no
IPTV_COUNTRY=CO
IPTV_LANG=spa
IPTV_EXCLUDE_NSFW=true
M3U_BASE_URL=
M3U_USERNAME=
M3U_PASSWORD=
M3U_TYPE=m3u

# OFF by default. Only if HTTPS is unavailable and the provider is trusted.
# Exact public provider DNS names and ports, comma-separated, e.g. media.example.com:8080
VIDAA_HTTP_VOD_ACK=no
VIDAA_HTTP_VOD_HOSTS=
