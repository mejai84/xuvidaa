# Choose an unused local port. Change the nginx proxy_pass port to match.
XUPER_PORT=3001
# HTTPS origin of the VPS subdomain; no path or trailing slash needed.
PUBLIC_BASE_URL=https://xuper.example.com
# Generate both secrets independently; do not use the placeholders.
MEDIA_TOKEN_SECRET=
# Set this only for Vercel frontend + private VPS JSON API mode.
# Configure the SAME value as XUPER_BACKEND_TOKEN in Vercel.
# Leave empty to serve the complete app directly from the VPS subdomain.
XUPER_BACKEND_TOKEN=
# Exact browser origin allowed to fetch signed media from the VPS.
XUPER_ALLOWED_ORIGINS=https://xuvidaa.vercel.app
# Optional extra exact CDN hostnames; signed portal hostnames are automatic.
MEDIA_ALLOWED_HOSTS=
# XUPER_BACKEND_URL is Vercel-only: never set it here.
