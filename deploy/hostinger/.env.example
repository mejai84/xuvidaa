# Names for private variables configured in the Dokploy service environment.
PUBLIC_BASE_URL=https://tv.rfcsas.com
MEDIA_TOKEN_SECRET=<generate-a-private-random-secret>
XUPER_SESSION_SECRET=<generate-a-different-private-random-secret>
XUPER_WEB_PASSWORD=<private-password-at-least-14-characters>
MEDIA_ALLOWED_HOSTS=
# IPTV-org: public TV channels
IPTV_COUNTRY=CO
IPTV_LANG=spa
IPTV_EXCLUDE_NSFW=true
# Private M3U: set values ONLY in Dokploy environment (never commit secrets)
M3U_BASE_URL=
M3U_USERNAME=
M3U_PASSWORD=
M3U_TYPE=m3u
# Old Magis provider is blocked for this deployment; off by default.
LEGACY_MAGIS_ENABLED=false
