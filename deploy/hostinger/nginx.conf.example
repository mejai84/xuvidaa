# Add to the EXISTING HTTPS virtual host for the new Xuper subdomain.
# Let the installed panel manage the certificate and existing other sites.
# Replace only the location / of that new subdomain, not nginx.conf globally.
location / {
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Overwrite untrusted forwarding input instead of appending it.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_request_buffering on;
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 60s;
    client_max_body_size 32k;
    # URLs contain signed media capabilities; keep them out of access logs.
    access_log off;
    error_log /var/log/nginx/xuper-error.log crit;
}
